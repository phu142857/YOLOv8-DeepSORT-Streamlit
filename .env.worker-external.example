# YOLO worker VM — external MLAir controller (split deploy)
#   cp .env.worker-external.example .env
#   docker compose -f compose.worker-external.yaml build
#   docker compose -f compose.worker-external.yaml up -d

# --- MLAir controller (browser-reachable URL from worker VM) ---
MLAIR_CONTROLLER_URL=http://192.168.120.182:8080
CV_MLAIR_HUB_URL=http://192.168.120.182:8080

# Worker lease token: use Service Account (NOT admin PAT). See scripts/provision-worker-sa.sh
CV_MLAIR_TOKEN=

# Scope on controller
CV_MLAIR_TENANT=yolo
CV_MLAIR_PROJECT=yoloVN

# --- Images ---
MLAIR_BASE_IMAGE=ghcr.io/phu142857/ml-air:latest
CV_IMAGE=cv-lifecycle-workload:latest
CV_WORKER_IMAGE=cv-lifecycle-workload:latest
PYTORCH_WHEEL=cpu

# GPU worker (uncomment + use docker-compose.gpu.yml overlay):
# COMPOSE_FILE=compose.worker-external.yaml:docker-compose.gpu.yml
# CV_WORKER_IMAGE=cv-lifecycle-workload:gpu
# CV_WORKER_PYTORCH_WHEEL=cu124
# CV_MLAIR_TRAIN_DEVICE=auto
# CV_MLAIR_TRAIN_BATCH=2

# --- Ports on worker VM ---
CV_API_PORT=8000
CV_UI_PORT=8501

# --- Pipeline / datasets ---
CV_DATASET_ZIP_MAX_MB=102400
CV_DATASET_ZIP_MAX_UNZIPPED_MB=512000
CV_MLAIR_DATASET_NAME=cv-traffic-frames
CV_MLAIR_PIPELINE_REQUIRED_SIZE=50
CV_MLAIR_TRAIN_PIPELINE_ID=cv-yolo-lifecycle-train
CV_MLAIR_PIPELINE_MODE=plugin
CV_MLAIR_BOOTSTRAP_PIPELINE=1
CV_MLAIR_AUTO_INGEST=1
# Push local weights → Hub registry metadata; do NOT mirror Hub file:// artifacts to worker volume.
CV_MLAIR_AUTO_SYNC_MODELS=1
CV_MLAIR_SYNC_ON_STARTUP=0
CV_MLAIR_MIRROR_REGISTRY_TO_LOCAL=0
CV_MLAIR_TRAIN_EPOCHS=10
CV_MLAIR_TRAIN_DEVICE=cpu

# Train reads base weights from ./weights/detection/{hub_model_name}/ when controller volume is absent.
CV_DETECTION_MODEL_DIR=weights/detection
