# Generated on app host by SSM deploy / Ansible
NAME_PREFIX=cv-mlair-dev
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
IMAGE_TAG=latest

# MLAir upstream (https://github.com/phu142857/ml-air)
MLAIR_REGISTRY=ghcr.io/phu142857
MLAIR_IMAGE_TAG=latest
# Optional if GHCR packages are private:
# GHCR_TOKEN=ghp_...
# GHCR_USER=phu142857

ML_AIR_DATABASE_URL=postgresql://mlair:SECRET@cv-mlair-dev-postgres.xxxx.ap-southeast-1.rds.amazonaws.com:5432/mlair
ML_AIR_REDIS_URL=redis://cv-mlair-dev-redis.xxxx.cache.amazonaws.com:6379/0

ML_AIR_JWT_HS256_SECRET=from-secrets-manager
ML_AIR_TRACKING_TOKEN=from-secrets-manager
# ml-air-api: maps CV_MLAIR_TOKEN (+ dev tokens) via ML_AIR_AUTH_TOKENS_JSON (set by ssm-deploy-stack.sh)
ML_AIR_AUTH_TOKENS_JSON=from-ssm-deploy
ML_AIR_MANIFEST_SIGNING_KEY=from-secrets-manager
CV_MLAIR_TOKEN=from-secrets-manager
CV_MLAIR_TRAIN_CALLBACK_TOKEN=from-secrets-manager
CV_MLAIR_PROMOTE_WEBHOOK_TOKEN=from-secrets-manager

# Public URLs (ALB)
NEXT_PUBLIC_API_BASE_URL=http://cv-mlair-dev-alb-xxxx.ap-southeast-1.elb.amazonaws.com
NEXT_PUBLIC_MLAIR_REALTIME_WS=ws://cv-mlair-dev-alb-xxxx.ap-southeast-1.elb.amazonaws.com/ws
ML_AIR_RUNTIME_API_BASE_URL=http://cv-mlair-dev-alb-xxxx.ap-southeast-1.elb.amazonaws.com
ML_AIR_RUNTIME_REALTIME_BASE_URL=ws://cv-mlair-dev-alb-xxxx.ap-southeast-1.elb.amazonaws.com/ws
CV_MLAIR_HUB_URL=http://cv-mlair-dev-alb-xxxx.ap-southeast-1.elb.amazonaws.com
CV_API_BASE_URL=http://cv-api:8000

ML_AIR_HTTP_TASK_ALLOWED_HOSTS=cv-api,api,localhost,127.0.0.1
CV_MLAIR_SYNC_AFTER_TRAIN=0
