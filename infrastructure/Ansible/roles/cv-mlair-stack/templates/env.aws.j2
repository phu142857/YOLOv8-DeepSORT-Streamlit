NAME_PREFIX={{ name_prefix }}
ECR_REGISTRY={{ ecr_registry }}
IMAGE_TAG={{ image_tag }}
MLAIR_REGISTRY={{ mlair_registry | default('ghcr.io/phu142857') }}
MLAIR_IMAGE_TAG={{ mlair_image_tag | default(image_tag) }}

ML_AIR_DATABASE_URL=postgresql://mlair:{{ app_secrets.POSTGRES_PASSWORD | urlencode }}@{{ rds_endpoint }}:5432/mlair?sslmode=require
ML_AIR_REDIS_URL=redis://{{ redis_endpoint }}:6379/0

ML_AIR_JWT_HS256_SECRET={{ app_secrets.ML_AIR_JWT_HS256_SECRET }}
ML_AIR_TRACKING_TOKEN={{ app_secrets.ML_AIR_TRACKING_TOKEN }}
ML_AIR_MANIFEST_SIGNING_KEY={{ app_secrets.ML_AIR_MANIFEST_SIGNING_KEY }}
CV_MLAIR_TOKEN={{ app_secrets.CV_MLAIR_TOKEN }}
CV_MLAIR_TRAIN_CALLBACK_TOKEN={{ app_secrets.ML_AIR_TRACKING_TOKEN }}
CV_MLAIR_PROMOTE_WEBHOOK_TOKEN={{ app_secrets.ML_AIR_TRACKING_TOKEN }}

NEXT_PUBLIC_API_BASE_URL=http://{{ alb_dns_name }}
NEXT_PUBLIC_MLAIR_REALTIME_WS=ws://{{ alb_dns_name }}/ws
ML_AIR_RUNTIME_REALTIME_BASE_URL=ws://{{ alb_dns_name }}/ws
CV_MLAIR_HUB_URL=http://{{ alb_dns_name }}
CV_API_BASE_URL=http://cv-api:8000

ML_AIR_HTTP_TASK_ALLOWED_HOSTS=cv-api,api,localhost,127.0.0.1
ML_AIR_SKIP_APPROVAL_FOR_PROMOTE=1
ML_AIR_TASK_EXECUTION_MODE=external
CV_MLAIR_SYNC_AFTER_TRAIN=0
CV_MLAIR_AUTO_SYNC_MODELS=1
CV_MLAIR_SYNC_ON_STARTUP=1
CV_CLIENT_SAVE_TO_DATASET=1
CV_MLAIR_PERSIST_INGEST_FRAMES=1
