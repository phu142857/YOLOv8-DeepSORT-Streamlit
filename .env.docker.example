# cp .env.docker.example .env
#
# Default stack: compose.yaml (MLAir app image + Grafana/Prometheus/MinIO + YOLO CV clients)
#   docker compose up -d
# GPU train worker (build cu124 image + device mounts):
#   ./scripts/compose build && ./scripts/compose up -d

# MLAir single entry (Hub + API + realtime on one port)
MLAIR_PORT=8080

# MLAir base image consumed by Dockerfile.mlair-cv
MLAIR_BASE_IMAGE=ml-air:latest
MLAIR_IMAGE=ml-air-cv:latest

# CV image — cv-api + cv-ui (CPU inference). Train worker: CV_WORKER_* below.
CV_IMAGE=cv-lifecycle-workload:latest

# ========== TRAIN COMPUTE — đổi GPU / CPU tại đây ==========
# Chỉ cần đổi CV_TRAIN_COMPUTE rồi: ./scripts/compose up -d --build mlair-cv-train-worker
# (Dùng ./scripts/compose thay vì docker compose thuần — script gắn docker-compose.gpu.yml khi gpu.)
CV_TRAIN_COMPUTE=gpu

# --- GPU (mặc định) — CV_TRAIN_COMPUTE=gpu ---
CV_GPU_TRAIN=auto
CV_WORKER_IMAGE=cv-lifecycle-workload:gpu
CV_WORKER_PYTORCH_WHEEL=cu124
CV_MLAIR_TRAIN_DEVICE=auto
CV_MLAIR_TRAIN_BATCH=2
CV_MLAIR_TRAIN_IMGSZ=512
CV_MLAIR_TRAIN_WORKERS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- CPU — đổi thành CV_TRAIN_COMPUTE=cpu (hoặc uncomment block dưới) ---
# CV_TRAIN_COMPUTE=cpu
# CV_GPU_TRAIN=0
# CV_WORKER_IMAGE=cv-lifecycle-workload:latest
# CV_WORKER_PYTORCH_WHEEL=cpu
# CV_MLAIR_TRAIN_DEVICE=cpu
# CV_MLAIR_TRAIN_BATCH=8
# MLAIR_IMAGE=ml-air:latest   # override the consumed MLAir image tag

CV_API_PORT=8000
CV_UI_PORT=8501
CV_API_BASE_URL=http://cv-api:8000
# Job frames/uploads in Docker volume cv_workload_artifacts (not ./artifacts bind).
CV_ARTIFACT_ROOT=/app/artifacts
CV_MLAIR_PERSIST_INGEST_FRAMES=0
# Dataset ZIP import limits (CV UI)
CV_DATASET_ZIP_MAX_MB=2048
CV_DATASET_ZIP_MAX_IMAGES=100000
CV_DATASET_ZIP_MAX_UNZIPPED_MB=20480
CV_MLAIR_TOKEN=admin-token
CV_MLAIR_TENANT=default
CV_MLAIR_PROJECT=default_project
CV_MLAIR_DATASET_NAME=cv-traffic-frames
# Pipeline input + training-policy minimum rows on Hub (match accumulation target_threshold).
CV_MLAIR_PIPELINE_REQUIRED_SIZE=50
CV_MLAIR_AUTO_INGEST=1
CV_MLAIR_AUTO_MATERIALIZE=0
# Threshold + accumulation strategy: configure on MLAir Hub (:8080) → dataset → Accumulation
CV_MLAIR_HUB_URL=http://localhost:8080
CV_CLIENT_SAVE_TO_DATASET=1

# Phase 3 — auto retrain (off by default; set model_id from MLAir Hub)
# CV_MLAIR_MODEL_ID=
# CV_MLAIR_AUTO_TRAIN=0
# CV_MLAIR_AUTO_PROMOTE=0
# CV_MLAIR_PROMOTE_STAGE=production

# Auto-sync weights/detection → MLAir registry (startup + every 5 min; after train)
CV_MLAIR_AUTO_SYNC_MODELS=1
CV_MLAIR_SYNC_ON_STARTUP=1
CV_MLAIR_SYNC_AFTER_TRAIN=1
CV_MLAIR_SYNC_INTERVAL_SEC=300
CV_MLAIR_MIRROR_REGISTRY_TO_LOCAL=1

# Hub Train: plugin pipeline + external worker (see docs/MLAIR_YOLO_TRAINING.md)
CV_MLAIR_PIPELINE_MODE=plugin
CV_MLAIR_TRAIN_PIPELINE_ID=cv-yolo-lifecycle-train
CV_MLAIR_LIFECYCLE_IMPORT_STAGE=staging
CV_MLAIR_LIFECYCLE_AUTO_PROMOTE=1
CV_MLAIR_GATE_MIN_MAP_DELTA=0.0
CV_MLAIR_HARD_EXAMPLE_DATASET=cv-traffic-hard-examples
ML_AIR_TASK_EXECUTION_MODE=external
# Hub Settings quotas only block when enforce=1 (see ml-air docs/api/tenant-quotas.md)
ML_AIR_TENANT_QUOTA_ENFORCE=1
# Long YOLO train: worker heartbeats every 15s; API extends lease (default was 30s → requeue loop)
ML_AIR_TASK_LEASE_SECONDS=300
MLAIR_HEARTBEAT_INTERVAL_SEC=1
MLAIR_RESOURCE_SAMPLE_INTERVAL_SEC=1
CV_MLAIR_TRAIN_EPOCHS=10
# Train device: auto (GPU if available, else CPU), cpu, 0, cuda:0
# Train device: auto = GPU if available else CPU; eval uses same auto (no streak)
CV_MLAIR_TRAIN_DEVICE=auto
# After N consecutive GPU train failures on cv-yolo-lifecycle-train, next train uses CPU (default 3)
CV_MLAIR_GPU_FAIL_STREAK_FOR_CPU=3
# Legacy: PYTORCH_WHEEL applied to cv-api build only; worker uses CV_WORKER_PYTORCH_WHEEL.
# PYTORCH_WHEEL=cpu

ML_AIR_API_PORT=8080
MLAIR_REALTIME_PORT=8001
MLAIR_REALTIME_ENABLED=true
ML_AIR_RUNTIME_REALTIME_BASE_URL=ws://localhost:8080/ws
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ML_AIR_TRACKING_TOKEN=admin-token
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
ML_AIR_GRAFANA_URL=http://localhost:33000
ML_AIR_OTEL_ENABLED=0
# Optional OTLP when ML_AIR_OTEL_ENABLED=1:
# OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317
ML_AIR_GRAFANA_PORT=33000
ML_AIR_PROMETHEUS_PORT=39090
ML_AIR_MINIO_API_PORT=9000
ML_AIR_MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
