# cp .env.docker.example .env

# MLAir images (GHCR — no source clone)
MLAIR_REGISTRY=ghcr.io/phu142857
MLAIR_TAG=latest

# CV image (built once from ./Dockerfile)
CV_IMAGE=cv-lifecycle-workload:latest

CV_API_PORT=8000
CV_UI_PORT=8501
CV_API_BASE_URL=http://cv-api:8000
CV_MLAIR_TOKEN=admin-token
CV_MLAIR_TENANT=default
CV_MLAIR_PROJECT=default_project
CV_MLAIR_DATASET_NAME=cv-traffic-frames
CV_MLAIR_AUTO_INGEST=1
CV_MLAIR_AUTO_MATERIALIZE=0
# Threshold + accumulation strategy: configure on MLAir Hub (:38080) → dataset → Accumulation
CV_MLAIR_HUB_URL=http://localhost:38080
CV_CLIENT_SAVE_TO_DATASET=1

# Phase 3 — auto retrain (off by default; set model_id from MLAir Hub)
# CV_MLAIR_MODEL_ID=
# CV_MLAIR_AUTO_TRAIN=0
# CV_MLAIR_AUTO_PROMOTE=0
# CV_MLAIR_PROMOTE_STAGE=production

# Auto-sync weights/detection → MLAir registry (startup + every 5 min; after train)
CV_MLAIR_AUTO_SYNC_MODELS=1
CV_MLAIR_SYNC_ON_STARTUP=1
CV_MLAIR_SYNC_AFTER_TRAIN=1
CV_MLAIR_SYNC_INTERVAL_SEC=300
CV_MLAIR_MIRROR_REGISTRY_TO_LOCAL=1

# MLAir plugin (install integrations/mlair_cv_plugins into ml-air-api — see docs/MLAIR_YOLO_TRAINING.md)
# Build: docker build -f deploy/Dockerfile.mlair-api-cv-plugins -t ml-air-api:cv-workload .

ML_AIR_API_PORT=8080
ML_AIR_FRONTEND_PORT=38080
MLAIR_REALTIME_PORT=8001
MLAIR_REALTIME_ENABLED=true
ML_AIR_RUNTIME_REALTIME_BASE_URL=ws://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ML_AIR_TRACKING_TOKEN=admin-token
ML_AIR_JWT_HS256_SECRET=mlair-dev-jwt-secret-32bytes-minimum-key
