# CV Lifecycle Workload
CV_ARTIFACT_ROOT=artifacts
CV_API_BASE_URL=http://127.0.0.1:8000
CV_API_PORT=8000
CV_LOG_LEVEL=INFO

# Job / pipeline
CV_PERSIST_JOBS=1
CV_FRAME_EXTRACT_INTERVAL=30
CV_MAX_VIDEO_FRAMES=0
CV_MAX_UPLOAD_MB=500
CV_JOB_POLL_TIMEOUT_SEC=600

# MLAir integration (Phase 2+) — https://github.com/phu142857/ml-air
CV_MLAIR_API_URL=http://localhost:8080
# Must be accepted by ml-air-api (static admin-token / maintainer-token, or registered in ML_AIR_AUTH_TOKENS_JSON).
CV_MLAIR_TOKEN=admin-token
CV_MLAIR_TENANT=default
CV_MLAIR_PROJECT=default_project
CV_MLAIR_DATASET_NAME=cv-traffic-frames
CV_MLAIR_AUTO_INGEST=1
CV_MLAIR_AUTO_MATERIALIZE=0
# Lifecycle train: 0 = full dataset version; N = cap first N manifest rows (quick QA)
CV_MLAIR_TRAIN_MAX_FRAMES=0
CV_MLAIR_DETECT_MAX_FRAMES=0

# --- Hybrid EKS worker tuning (used by infrastructure scripts) ---
# Default 1 worker pod; set 4 only when demonstrating parallel-task leasing.
CV_TRAIN_WORKER_MIN_REPLICAS=1
CV_TRAIN_WORKER_MAX_REPLICAS=1
# Set N>0 to disable HPA and force exactly N replicas.
CV_TRAIN_WORKER_FIXED_POOL=0

# Training knobs pushed into worker env by `eks-deploy-stack.sh`
CV_TRAIN_WORKER_TRAIN_MAX_FRAMES=1000
CV_TRAIN_WORKER_DETECT_MAX_FRAMES=0
CV_TRAIN_WORKER_TRAIN_EPOCHS=10
CV_TRAIN_WORKER_TRAIN_BATCH=4
CV_TRAIN_WORKER_TRAIN_WORKERS=0
