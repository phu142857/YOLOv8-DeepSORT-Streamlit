# CV Lifecycle Workload
CV_ARTIFACT_ROOT=artifacts
CV_API_BASE_URL=http://127.0.0.1:8000
CV_API_PORT=8000
CV_LOG_LEVEL=INFO

# Job / pipeline
CV_PERSIST_JOBS=1
CV_FRAME_EXTRACT_INTERVAL=30
CV_MAX_VIDEO_FRAMES=0
CV_MAX_UPLOAD_MB=500
CV_JOB_POLL_TIMEOUT_SEC=600

# MLAir integration (Phase 2+) — https://github.com/phu142857/ml-air
CV_MLAIR_API_URL=http://localhost:8080
CV_MLAIR_TOKEN=maintainer-token
CV_MLAIR_TENANT=default
CV_MLAIR_PROJECT=default_project
CV_MLAIR_DATASET_NAME=cv-traffic-frames
CV_MLAIR_AUTO_INGEST=1
CV_MLAIR_AUTO_MATERIALIZE=0
